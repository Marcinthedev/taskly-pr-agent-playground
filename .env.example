POSTGRES_HOST=localhost
POSTGRES_USER=taskly
POSTGRES_PASSWORD=taskly
POSTGRES_DB=taskly
DB_PORT=5432
API_PORT=8000
WEB_PORT=8080

# Optional local override; otherwise the URL is built from the values above.
# DATABASE_URL=postgresql://taskly:taskly@localhost:5432/taskly

# Optional: browser origins allowed to call the API cross-origin (comma-separated).
# Leave empty when the frontend is served from the same origin (nginx proxy).
# CORS_ORIGINS=https://app.example.com
# Optional: task API requests per client IP per minute (default 300).
# RATE_LIMIT_MAX=300
