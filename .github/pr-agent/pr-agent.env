# Non-secret PR agent settings. Read from the base branch, so a PR can't change them.
# A repository variable with the same name overrides a value here.
# Keys and tokens never go here: they are repository secrets.

# --- Agent ---------------------------------------------------------------
# To switch, replace these three lines with a preset from the list below.
PR_AGENT_ENGINE=claude-code
PR_AGENT_API_BASE_URL=
PR_AGENT_MODEL=claude-sonnet-5-5

# --- Limits and delivery -------------------------------------------------
PR_AGENT_MAX_TURNS=40
# 1 to 25
PR_AGENT_TIMEOUT_MINUTES=15
# false gives a patch file instead of a commit
PR_AGENT_AUTO_COMMIT=true
# true keeps the agent's full transcript for 14 days
PR_AGENT_KEEP_TRANSCRIPT=false

# --- Agent presets -------------------------------------------------------
# Model IDs change over time: check the provider's model list if one is rejected.
# The model must support tool calling.
#
# Claude Code (default). Secret: CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY
#   PR_AGENT_ENGINE=claude-code
#   PR_AGENT_API_BASE_URL=
#   PR_AGENT_MODEL=claude-sonnet-5-5      (or claude-opus-5-5, claude-haiku-5-5)
#
# Every preset below uses the secret PR_AGENT_API_KEY.
#
# OpenAI (ChatGPT models). Paid
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://api.openai.com/v1
#   PR_AGENT_MODEL=gpt-5                  (or gpt-5-mini)
#
# Google Gemini. Free tier with rate limits
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   PR_AGENT_MODEL=gemini-2.5-flash       (or gemini-2.5-pro)
#
# OpenRouter, many vendors behind one key. Models ending in :free cost nothing
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://openrouter.ai/api/v1
#   PR_AGENT_MODEL=qwen/qwen3-coder:free  (or openai/gpt-5, google/gemini-2.5-pro)
#
# Groq, fast open models. Free tier with rate limits
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://api.groq.com/openai/v1
#   PR_AGENT_MODEL=openai/gpt-oss-120b    (or llama-3.3-70b-versatile)
#
# Mistral. Paid, with a free experiment tier
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://api.mistral.ai/v1
#   PR_AGENT_MODEL=codestral-latest       (or mistral-large-latest)
#
# DeepSeek. Paid, low cost
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://api.deepseek.com/v1
#   PR_AGENT_MODEL=deepseek-chat
#
# xAI Grok. Paid
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://api.x.ai/v1
#   PR_AGENT_MODEL=grok-4
#
# Self-hosted (Ollama, vLLM). Free, but needs your own server reachable over HTTPS.
# The secret can be any value if the server has no key.
#   PR_AGENT_ENGINE=openai-compatible
#   PR_AGENT_API_BASE_URL=https://your-server.example.com/v1
#   PR_AGENT_MODEL=qwen2.5-coder:32b
