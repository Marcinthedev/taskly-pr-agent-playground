# Fast local checks before code leaves your machine: the problems CI would
# report, minutes earlier. CI stays the authority; `git push --no-verify` skips
# this hook (needed, for example, to push the demo feature that breaks tests on
# purpose).
set -e

if ! node -e "process.exit(Number(process.versions.node.split('.')[0]) >= 22 ? 0 : 1)" 2>/dev/null; then
  echo "pre-push: Node.js 22+ is required, found $(node -v 2>/dev/null || echo none). Switch with nvm, or push with --no-verify."
  exit 1
fi

# Compare with what the remote already has: the upstream branch, or origin/main
# for a branch that was never pushed.
base="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)"
changed="$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- backend frontend 2>/dev/null || true)"
[ -z "$changed" ] && exit 0

if printf '%s\n' "$changed" | grep -q '^backend/'; then
  echo "pre-push: backend typecheck and related tests"
  (cd backend && npm run --silent typecheck && npx vitest run --changed "$base" --passWithNoTests)
fi

if printf '%s\n' "$changed" | grep -q '^frontend/'; then
  echo "pre-push: frontend typecheck, formatting and related tests"
  (cd frontend && npm run --silent typecheck)
  files="$(printf '%s\n' "$changed" | grep -E '^frontend/src/.+\.(ts|tsx)$' | sed 's#^frontend/##' || true)"
  if [ -n "$files" ]; then
    # shellcheck disable=SC2086 # one path per word; repo paths contain no spaces
    (cd frontend && npx prettier --check --end-of-line auto $files)
  fi
  (cd frontend && npx vitest run --changed "$base" --passWithNoTests)
fi
