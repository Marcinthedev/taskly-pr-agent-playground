+            Clear completed ({completedCount})
+          </Button>
+        )}
+        <Button disabled={disabled} onClick={onCreate}>
+          <Plus size={18} aria-hidden="true" />
+          New task
+        </Button>
+      </div>
     </section>
   )
 }
